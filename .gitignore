# ============================================================================
#  Facturación — .gitignore
# ============================================================================

# --- Datos sensibles / privados (¡NUNCA subir a GitHub!) ---------------------
# Sistema Access legacy con datos reales de clientes (fuente de migración).
Modelo Actual - Access/
# Paquete de distribución al usuario final (incluye la base con datos).
Distribucion/

# Bases de datos y formatos con datos
*.mdb
*.accdb
*.mde
*.db
*.db-wal
*.db-shm
*.sqlite
*.sqlite3

# Listas de precios y planillas reales (importación Excel)
*.xls
*.xlsx
*.xlsm

# PDFs generados (facturas/remesas reales)
*.pdf
documentosPDF/

# --- Artefactos de build (PyInstaller / Flet / paquetes) ---------------------
desktop/packaging/build/
desktop/packaging/dist/
build/
dist/
*.manifest
# Flet: storage de desarrollo y copia vendorizada del core (se regenera al buildear)
.flet/
mobile/src/vexa_core/
# Paquetes de release (app compilada) y APKs de la mobile
Vexa-*.zip
*.apk
*.aab

# Notas / roadmaps locales (no se suben a GitHub)
*.local.md

# --- Python ------------------------------------------------------------------
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
.eggs/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# Entornos virtuales
.venv/
venv/
env/
ENV/

# --- Herramientas / IDE / editores -------------------------------------------
.claude/
.idea/
.vscode/
*.swp
*~

# --- Sistema operativo -------------------------------------------------------
Thumbs.db
desktop.ini
.DS_Store

# Bocetos de diseño (referencia visual, no se versionan)
design/

# Base pre-cargada para el APK (datos reales de clientes)
mobile/src/seed_data.db

# Screenshots del E2E visual (datos reales de clientes)
mobile/e2e_visual/shots/
